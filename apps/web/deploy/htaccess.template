# Deploy this as .htaccess in the Hostinger public_html root after every
# build (dist/.htaccess does not survive `pnpm build` -- Vite wipes dist/).
# See docs/runbooks/deploy.md for the full sequence.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Assets and any recognized static extension serve directly, by pattern --
# not by -f/-d check, which misfired on this host's LiteSpeed
# rewrite-compatibility layer for the site's JS/CSS bundles specifically
# (see the deploy runbook: the real cause turned out to be Hostinger's
# File Manager zip-upload scanner, not this rule, but the pattern match is
# kept as-is since it's known-working and there is no reason to touch it).
RewriteRule ^assets/ - [L]
RewriteRule \.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|json|txt|xml)$ - [L]

# Pre-rendered routes (scripts/prerender.mjs writes dist/<path>/index.html
# for every deposited item, CMS page, and article -- work plan Part II, #6):
# serve the real file/directory when one exists at this path, so a crawler,
# archiver, or link-preview bot fetching the permalink directly gets real
# content instead of the SPA shell. Falls through to the SPA entry point
# for everything else.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
