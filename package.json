{
  "name": "paz-os",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "bash scripts/test-db.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml}\"",
    "sitemap": "node scripts/generate-sitemap.mjs apps/web/dist/sitemap.xml",
    "db:diff": "supabase db diff --linked --schema public,identity,authz,admin,api",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema identity,authz,admin,api,publishing,programs,membership,crm,hospitality > packages/types/src/database.generated.ts"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.8"
  }
}
