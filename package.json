{
  "name": "paz-os",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "bash scripts/test-db.sh",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,yml}\"",
    "prerender": "node scripts/prerender.mjs apps/web/dist",
    "site": "node scripts/clean-dist.mjs && pnpm build && pnpm prerender",
    "sync:wording": "node -e \"require('fs').copyFileSync('apps/web/src/modules/site/wording.json','supabase/functions/_shared/wording.json')\"",
    "check:deployed": "node scripts/check-deployed.mjs",
    "check:palette": "node scripts/check-palette.mjs",
    "lcp": "node scripts/check-lcp-budget.mjs",
    "db:diff": "supabase db diff --linked --schema public,identity,authz,admin,api",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema identity,authz,admin,api,publishing,programs,membership,crm,wall,sattal,governance,commons,guild,treasury,encounters,mail,house,record > packages/types/src/database.generated.ts"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "prettier": "^3.3.0",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "playwright-core": "^1.48.0"
  },
  "pnpm": {
    "overrides": {
      "handlebars@>=4.0.0 <4.7.9": ">=4.7.9",
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2",
      "nanoid@<3.3.18": ">=3.3.18 <4",
      "postcss@<=8.5.22": ">=8.5.23",
      "browserslist@<=4.28.6": ">=4.28.7"
    }
  }
}
