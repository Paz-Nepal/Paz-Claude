# Copy to supabase/functions/.env for `supabase functions serve` locally.
# Never commit the real file — it's gitignored.
#
# In staging/production these are set with:
#   supabase secrets set --env-file supabase/functions/.env.production
# (a file that also never gets committed — see docs/runbooks/environments.md).

# Resend API key (ADR-11: transactional email provider). Get one at
# https://resend.com after verifying the sending domain.
RESEND_API_KEY=re_replace_with_real_key

# Must be a verified sender on the Resend domain above, e.g.
# "PAZ <hello@paz.example>". Replace paz.example with the real domain.
EMAIL_FROM=PAZ <hello@paz.example>

# The public site's base URL, no trailing slash. Used to build links in
# emails (e.g. the membership invitation acceptance link) -- Edge
# Functions have no other way to know where the frontend is deployed.
PUBLIC_SITE_URL=http://127.0.0.1:3000

# Payments scaffolding (T-040) -- UNRUN. Built ahead of the Architecture
# Blueprint's own Phase 3 scoping ("deliberately deferred rather than
# half-built", §4.4) at the user's explicit request; see
# docs/adr/037-online-payment-scaffolding.md. None of this has ever
# executed against a real eSewa/Khalti endpoint -- no merchant account
# exists yet for either gateway. Do not set real production secrets here.

# eSewa ePay v2 (https://developer.esewa.com.np/). Get merchant
# credentials by registering as an eSewa merchant; the test/sandbox
# constants below are eSewa's own published test values, not secrets.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace_with_real_esewa_secret_key
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Khalti ePayment / KPG-2 (https://docs.khalti.com/). Get a secret key by
# registering as a Khalti merchant.
KHALTI_SECRET_KEY=replace_with_real_khalti_secret_key
KHALTI_INITIATE_URL=https://dev.khalti.com/api/v2/epayment/initiate/
KHALTI_LOOKUP_URL=https://dev.khalti.com/api/v2/epayment/lookup/
