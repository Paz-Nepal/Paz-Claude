# Copy to supabase/functions/.env for `supabase functions serve` locally.
# Never commit the real file — it's gitignored.
#
# In staging/production these are set with:
#   supabase secrets set --env-file supabase/functions/.env.production
# (a file that also never gets committed — see docs/runbooks/environments.md).

# Resend API key (ADR-11: transactional email provider). Get one at
# https://resend.com after verifying the sending domain.
RESEND_API_KEY=re_replace_with_real_key

# Must be a verified sender on the Resend domain above, e.g.
# "PAZ <hello@paz.example>". Replace paz.example with the real domain.
EMAIL_FROM=PAZ <hello@paz.example>
